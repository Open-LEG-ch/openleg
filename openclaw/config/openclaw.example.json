{
  "agents": {
    "defaults": {
      "model": {
        "primary": "groq/llama-3.3-70b-versatile",
        "fallbacks": ["groq/qwen/qwen3-32b", "groq/llama-3.1-8b-instant"]
      },
      "models": {
        "groq/llama-3.3-70b-versatile": { "alias": "Llama 70B" },
        "groq/qwen/qwen3-32b": { "alias": "Qwen3 32B" },
        "groq/llama-3.1-8b-instant": { "alias": "Llama 8B" }
      },
      "workspace": "/home/node/.openclaw/workspace"
    }
  },

  "models": {
    "providers": {
      "groq": {
        "baseUrl": "https://api.groq.com/openai/v1",
        "apiKey": "${GROQ_API_KEY}",
        "api": "openai-completions",
        "models": [
          { "id": "llama-3.3-70b-versatile", "name": "Llama 3.3 70B Versatile" },
          { "id": "qwen/qwen3-32b", "name": "Qwen3 32B" },
          { "id": "llama-3.1-8b-instant", "name": "Llama 3.1 8B Instant" }
        ]
      }
    }
  },

  "gateway": {
    "port": 18789,
    "bind": "custom",
    "customBindHost": "0.0.0.0",
    "trustedProxies": ["172.16.0.0/12", "10.0.0.0/8"],
    "controlUi": {
      "allowedOrigins": ["https://claw.openleg.ch"],
      "dangerouslyAllowHostHeaderOriginFallback": true
    },
    "auth": {
      "mode": "password",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "password": "${OPENCLAW_GATEWAY_PASSWORD}"
    }
  },

  "tools": {
    "profile": "full"
  },

  "mcp": {
    "servers": {
      "openleg": {
        "command": "node",
        "args": ["/opt/mcp-openleg-server/server.mjs"],
        "env": {
          "DATABASE_URL": "${DATABASE_URL}",
          "BRAVE_API_KEY": "${BRAVE_API_KEY}",
          "INTERNAL_TOKEN": "${INTERNAL_TOKEN}",
          "FLASK_URL": "${FLASK_URL}",
          "OPENCLAW_READONLY": "${OPENCLAW_READONLY}",
          "AGENTMAIL_API_BASE": "${AGENTMAIL_API_BASE}",
          "AGENTMAIL_API_KEY": "${AGENTMAIL_API_KEY}",
          "AGENTMAIL_WEBHOOK_SECRET": "${AGENTMAIL_WEBHOOK_SECRET}",
          "LEA_INBOX_ADDRESS": "${LEA_INBOX_ADDRESS}",
          "AGENTMAIL_HUMAN_EMAIL": "${AGENTMAIL_HUMAN_EMAIL}",
          "LEA_AGENT_ID": "${LEA_AGENT_ID}"
        }
      }
    }
  },

  "session": {
    "dmScope": "per-channel-peer",
    "reset": { "mode": "daily", "atHour": 4 }
  },

  "cron": {
    "enabled": false
  }
}
