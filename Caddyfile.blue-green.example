# Public API
api.openleg.ch {
    reverse_proxy {{UPSTREAM}} {
        health_uri /health
        health_interval 10s
        health_timeout 3s
    }
}

# Main site
openleg.ch {
    reverse_proxy {{UPSTREAM}} {
        health_uri /health
        health_interval 10s
        health_timeout 3s
    }
}

# www redirect
www.openleg.ch {
    redir https://openleg.ch{uri} permanent
}
