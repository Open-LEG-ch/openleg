# OpenLEG Environment Variables
# Copy this file to .env and fill in your values

# === PostgreSQL ===
POSTGRES_PASSWORD=your-secure-postgres-password

# === Application Settings ===
APP_BASE_URL=http://localhost:5000
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL is set automatically in docker-compose.yml

# === Email (SMTP) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=noreply@example.com
ADMIN_EMAIL=admin@example.com

# === Analytics ===
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# === Admin Access ===
ADMIN_TOKEN=your-secure-admin-token

# === OpenClaw (optional) ===
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=your-model-api-key
MODEL_ID=your-model-id
OPENCLAW_GATEWAY_TOKEN=change-me-token
OPENCLAW_GATEWAY_PASSWORD=change-me-password
OPENCLAW_GATEWAY_BIND=loopback
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_READONLY=true
BRAVE_API_KEY=

# === Session Settings ===
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# === Data Storage (for JSON fallback) ===
DATA_DIR=/data
TOKEN_FILE=/data/openleg_tokens.json
