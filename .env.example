# OpenLEG Environment Variables
# Copy this file to .env and fill in your values

# === PostgreSQL ===
POSTGRES_USER=openleg
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=openleg

# === Application Settings ===
APP_BASE_URL=http://localhost:5003
PUBLIC_SITE_URL=https://openleg.ch
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL is set automatically in docker-compose.yml

# === Email (SMTP) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=noreply@example.com
ADMIN_EMAIL=admin@example.com

# === Analytics ===
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# === Admin Access ===
ADMIN_TOKEN=your-secure-admin-token
INTERNAL_TOKEN=your-secure-internal-token

# === Cron Authentication (required for /api/cron/* endpoints) ===
CRON_SECRET=your-secure-cron-secret

# === Cache / Rate Limiting ===
REDIS_URL=redis://redis:6379/1

# === Database Pool (optional) ===
DB_POOL_MIN=2
DB_POOL_MAX=10

# === DeepSign e-signatures (optional) ===
DEEPSIGN_API_URL=https://api.deepsign.ch/v1
DEEPSIGN_API_KEY=
DEEPSIGN_WEBHOOK_SECRET=

# === LEA AgentMail (private ops) ===
AGENTMAIL_API_BASE=https://api.agentmail.to/v0
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
AGENTMAIL_WEBHOOK_URL=
AGENTMAIL_HUMAN_EMAIL=hallo@mail.openleg.ch
LEA_INBOX_ADDRESS=lea@mail.openleg.ch
LEA_AGENT_ID=openleg-lea

# === Swisseldex Datahub (SDAT-Abruf über ftpes://datahub.swisseldex.ch) ===
# Zugangsdaten kommen vom Datahub-Onboarding. Abruf: python scripts/fetch_sdat.py
SWISSELDEX_FTPS_HOST=datahub.swisseldex.ch
SWISSELDEX_FTPS_PORT=21
SWISSELDEX_FTPS_USER=
SWISSELDEX_FTPS_PASSWORD=
# Verzeichnis auf dem Datahub, in dem der VNB die SDAT-Dateien ablegt
SWISSELDEX_FTPS_REMOTE_DIR=/
# Lokales Zielverzeichnis (liegt unter data/ und ist damit gitignoriert)
SWISSELDEX_SDAT_DIR=data/sdat
SWISSELDEX_FTPS_TIMEOUT=60
SWISSELDEX_FTPS_PASSIVE=true
# TLS-Prüfung nur abschalten, wenn der Datahub ein privates Zertifikat nutzt
SWISSELDEX_FTPS_VERIFY_TLS=true
SWISSELDEX_FTPS_CA_BUNDLE=

# === Session Settings ===
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# === Data Storage (for JSON fallback) ===
DATA_DIR=/data
TOKEN_FILE=/data/openleg_tokens.json
