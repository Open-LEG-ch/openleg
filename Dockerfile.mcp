# Local development only. No Flask dependencies or database configuration.
FROM python:3.11-slim
WORKDIR /app
COPY requirements-mcp.txt .
RUN pip install --no-cache-dir -r requirements-mcp.txt
COPY mcp_sidecar/ mcp_sidecar/
COPY docs/openapi/operator-v1.yaml docs/openapi/operator-v1.yaml
USER 65534:65534
CMD ["python", "-m", "mcp_sidecar"]
